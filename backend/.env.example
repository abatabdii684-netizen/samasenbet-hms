# ─────────────────────────────────────────
# YFM GENERAL HOSPITAL PLC — Backend Environment
# ─────────────────────────────────────────

# Application
NODE_ENV=development
PORT=5000
APP_NAME="Yohannes Fantaye Metasebiya General Hospital PLC"
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="mysql://root:@localhost:3306/samasenbet_hms"

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Reports
REPORT_DIR=reports

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="YFM General Hospital PLC <no-reply@yfmhospital.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
